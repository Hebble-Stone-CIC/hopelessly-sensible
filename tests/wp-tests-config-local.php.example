<?php
/**
 * Local paths for the test suite, on this machine only.
 *
 * Copy this file to tests/wp-tests-config-local.php and edit it. That copy is
 * ignored by git, so nobody else ever sees your directory layout.
 *
 * Every key here can equally be set as an environment variable, which is what
 * continuous integration should do. The variable name is the key in upper case
 * with a HOPSEN_ prefix: wp_root becomes HOPSEN_WP_ROOT, and so on. The
 * environment wins where both are set, so this file holds your everyday setup
 * and a variable on the command line points a single run somewhere else.
 *
 * Running against the oldest WordPress the plugin supports takes three of them,
 * because the wp-phpunit library composer installs here tracks the newest
 * WordPress and has to match the one under test. Install the matching line
 * somewhere outside this repo, with
 * `composer require --working-dir=/path/to/wp-phpunit-6.5 "wp-phpunit/wp-phpunit:6.5.*"`,
 * and point WP_TESTS_DIR at it:
 *
 *     WP_TESTS_DIR=/path/to/wp-phpunit-6.5/vendor/wp-phpunit/wp-phpunit \
 *     HOPSEN_WP_ROOT=/path/to/wordpress-6.5 HOPSEN_THEME=twentytwentyfour composer test
 *
 * Only the first two usually need changing.
 *
 * @package HopelesslySensible
 */

return array(

	// A WordPress installation: the directory holding wp-settings.php.
	'wp_root'   => '/path/to/a/wordpress/site/app/public',

	/*
	 * A MySQL socket, if your setup uses one. Local, MAMP, DBngin and Docker
	 * Desktop all do. Leave it empty to use db_host below instead.
	 */
	'db_socket' => '',

	// An ordinary host and port. Ignored whenever db_socket is set.
	'db_host'   => '127.0.0.1',

	// Credentials for that server. It needs permission to create a database.
	'db_user'   => 'root',
	'db_pass'   => 'root',

	/*
	 * The database the suite installs into. EVERY TABLE IN IT IS DROPPED BEFORE
	 * EVERY RUN, so give it a name no real site would ever have.
	 * tests/bootstrap.php refuses to start if this looks like a real site.
	 */
	'db_name'   => 'hopsen_tests',

	/*
	 * A theme the installer can find. The default only exists on WordPress 7.0
	 * and later, so name an older one when testing the plugin's minimum.
	 */
	'theme'     => 'twentytwentyfive',
);
